Subject: [PATCH 2/3 RFC] dt-bindings: media: describe experimental Meson8b VDEC

Describe Meson8b with three clocks and the local PMU syscon window.
This binding accompanies guarded platform bring-up, not verified decoding.

---
diff --git a/Documentation/devicetree/bindings/media/amlogic,gx-vdec.yaml b/Documentation/devicetree/bindings/media/amlogic,gx-vdec.yaml
index 5044c4b..ca232cb 100644
--- a/Documentation/devicetree/bindings/media/amlogic,gx-vdec.yaml
+++ b/Documentation/devicetree/bindings/media/amlogic,gx-vdec.yaml
@@ -35,6 +35,7 @@ properties:
               - amlogic,gxm-vdec # GXM (S912)
           - const: amlogic,gx-vdec
       - enum:
+          - amlogic,meson8b-vdec # Meson8b (S805), H.264 only
           - amlogic,g12a-vdec # G12A (S905X2, S905D2)
           - amlogic,sm1-vdec # SM1 (S905X3, S905D3)
 
@@ -62,11 +63,11 @@ properties:
       - const: esparser
 
   clocks:
-    minItems: 4
+    minItems: 3
     maxItems: 5
 
   clock-names:
-    minItems: 4
+    minItems: 3
     items:
       - const: dos_parser
       - const: dos
@@ -75,7 +76,9 @@ properties:
       - const: vdec_hevcf
 
   amlogic,ao-sysctrl:
-    description: should point to the AOBUS sysctrl node
+    description: |
+      Should point to the AOBUS sysctrl node. On Meson8b this is the
+      amlogic,meson8b-pmu syscon window starting at AO offset 0xe0.
     $ref: /schemas/types.yaml#/definitions/phandle
 
   amlogic,canvas:
@@ -83,6 +86,24 @@ properties:
     $ref: /schemas/types.yaml#/definitions/phandle
 
 allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: amlogic,meson8b-vdec
+    then:
+      properties:
+        clocks:
+          maxItems: 3
+        clock-names:
+          maxItems: 3
+    else:
+      properties:
+        clocks:
+          minItems: 4
+        clock-names:
+          minItems: 4
+
   - if:
       properties:
         compatible:
