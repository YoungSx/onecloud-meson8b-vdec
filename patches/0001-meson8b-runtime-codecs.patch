+static inline void venc_jpeg_quantize(u8 quant[2][64], unsigned int quality)
+{
+	unsigned int scale = quality < 50 ? 5000 / quality : 200 - 2 * quality;
+	unsigned int i, t;
+
+	for (t = 0; t < 2; t++) {
+		const u8 *base = t ? jpeg_chroma_q_table : jpeg_luma_q_table;
+
+		for (i = 0; i < 64; i++) {
+			unsigned int q = (base[i] * scale + 50) / 100;
+
+			quant[t][i] = q < 1 ? 1 : q > 255 ? 255 : q;
+		}
+	}
+}
+
+/* Canonical codes, with the vendor's EOB/ZRL and (size, run) LUT ordering. */
+static inline void venc_jpeg_huffman(u32 *lut, const u8 *table, int ac)
+{
+	unsigned int code = 0, pos = 16, bits, n;
+
+	for (bits = 1; bits <= 16; bits++) {
+		for (n = 0; n < table[bits - 1]; n++) {
+			unsigned int symbol = table[pos++], addr = symbol;
+
+			if (ac)
+				addr = symbol == 0 ? 0 : symbol == 0xf0 ? 161 :
+					1 + 16 * ((symbol & 15) - 1) + (symbol >> 4);
+			lut[addr] = ((bits - 1) << 16) | code++;
+		}
+		code <<= 1;
+	}
+}
+
+static inline u16 venc_jpeg_reciprocal(u8 q)
+{
+	return q == 1 ? 65535 : 65536 / q;
+}
+
+static inline void venc_jpeg_put16(u8 **p, unsigned int value)
+{
+	*(*p)++ = value >> 8;
+	*(*p)++ = value;
+}
+
+/* Includes JFIF: the raw source samples must be full-range YCbCr. */
+static inline void venc_jpeg_header(u8 *buffer, unsigned int width,
+				    unsigned int height, const u8 quant[2][64])
+{
+	const u8 *tables[] = { jpeg_luma_dc_table, jpeg_luma_ac_table,
+			       jpeg_chroma_dc_table, jpeg_chroma_ac_table };
+	const unsigned int lengths[] = { 28, 178, 28, 178 };
+	const u8 ids[] = { 0, 0x10, 1, 0x11 };
+	const u8 jfif[] = { 'J', 'F', 'I', 'F', 0, 1, 1, 0, 0, 1, 0, 1, 0, 0 };
+	u8 *p = buffer;
+	unsigned int t, i;
+
+	venc_jpeg_put16(&p, 0xffd8);
+	venc_jpeg_put16(&p, 0xffe0);
+	venc_jpeg_put16(&p, 16);
+	for (i = 0; i < sizeof(jfif); i++)
+		*p++ = jfif[i];
+	venc_jpeg_put16(&p, 0xffdb);
+	venc_jpeg_put16(&p, 132);
+	for (t = 0; t < 2; t++) {
+		*p++ = t;
+		for (i = 0; i < 64; i++)
+			*p++ = quant[t][jpeg_zigzag[i]];
+	}
+	venc_jpeg_put16(&p, 0xffc4);
+	venc_jpeg_put16(&p, 418);
+	for (t = 0; t < 4; t++) {
+		*p++ = ids[t];
+		for (i = 0; i < lengths[t]; i++)
+			*p++ = tables[t][i];
+	}
+	venc_jpeg_put16(&p, 0xffc0);
+	venc_jpeg_put16(&p, 17);
+	*p++ = 8;
+	venc_jpeg_put16(&p, height);
+	venc_jpeg_put16(&p, width);
+	*p++ = 3;
+	for (t = 0; t < 3; t++) {
+		*p++ = t + 1;
+		*p++ = t ? 0x11 : 0x22;
+		*p++ = t ? 1 : 0;
+	}
+	/* The VLC DMA starts on an eight-byte boundary. */
+	while (p - buffer < VENC_JPEG_HEADER_SIZE - 14)
+		*p++ = 0xff;
+	venc_jpeg_put16(&p, 0xffda);
+	venc_jpeg_put16(&p, 12);
+	*p++ = 3;
+	for (t = 0; t < 3; t++) {
+		*p++ = t + 1;
+		*p++ = t ? 0x11 : 0;
+	}
+	*p++ = 0;
+	*p++ = 63;
+	*p++ = 0;
+}
+#endif
